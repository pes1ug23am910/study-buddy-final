# ============================
# StudyBuddy .gitignore
# ============================

# ---------- Python ----------
__pycache__/
*.py[cod]
*$py.class
*.pyo
*.pyd

# ---------- Virtual environments ----------
venv/
env/
.venv/
ENV/

# ---------- IDE / Editor ----------
.vscode/
.idea/
*.swp
*.swo
*~

# ---------- Runtime output (generated at runtime, not source) ----------
output/

# ---------- Environment / Secrets ----------
.env
.env.*

# ---------- OS ----------
.DS_Store
Thumbs.db
desktop.ini
ehthumbs.db

# ---------- Distribution / Packaging ----------
dist/
build/
*.egg-info/
*.egg
*.whl

# ---------- Testing ----------
.pytest_cache/
.coverage
htmlcov/
.tox/
.nox/

# ---------- Jupyter ----------
.ipynb_checkpoints/

# ---------- Binary / Large assets ----------
docs/*.drawio
Card and thumbnail/

# ---------- Internal / non-public docs ----------
MERGE_CHECKLIST.md
HUMANIZATION_CHECKLIST.md
FINAL_CHECKLIST.md
KAGGLE_SUBMISSION.md
KAGGLE_WRITEUP.md
VIDEO_CHECKLIST.md
VIDEO_SCRIPT.md

# ---------- Utility scripts (internal tooling) ----------
remove_emojis.py
demo_video.py

# ---------- Kaggle notebooks (large, auto-generated) ----------
studybuddy_kaggle.ipynb
studybuddy_kaggle_full.ipynb

# ---------- Logs ----------
*.log
logs/
